# Server port
PORT=4000

# Firebase Admin SDK — get from Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Option 1: Path to the downloaded JSON key file (for local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2: Inline JSON (for Render deployment — paste the entire JSON as a single line)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# Firebase project ID (same as in client config)
FIREBASE_PROJECT_ID=your_project_id

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com
